# Optional alternative to the masked BYOK screen: python3 tools/configure_model.py
# Copy to .env with mode 600. Never paste real credentials into chat or commit them.
MISTRAL_API_KEY=
# --models lechonk pins direct Studio and exact mistral-large-4 for EVERY role.
# --models configured uses config/llm.json (see config/llm.example.json).
# Cheap development-only profiles use OpenRouter; they are not contest runs.
OPENROUTER_API_KEY=
# Maximum concurrent requests per model; the game writer always remains single-threaded.
LLM_MAX_PARALLEL_PER_MODEL=2
# Optional general web search. Large4 Preview does not support Studio builtin connectors.
# Operator-provided SearXNG endpoint with JSON enabled; blank leaves wiki/game files available.
LECHONK_SEARCH_URL=
